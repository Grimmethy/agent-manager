{
  "entries": [
    {
      "id": "morning-standup",
      "cadence": { "at": { "time": "09:00", "weekday": "mon" } },
      "job": { "queue-task": { "pipeline": "standup", "priority": "normal" } },
      "replaceWith": "standup-slack"
    },
    {
      "id": "weekend-check",
      "cadence": { "at": { "time": "10:00", "weekday": "sat" } },
      "job": { "queue-task": { "pipeline": "report", "priority": "normal" } },
      "replaceWith": "weekend-report"
    },
    {
      "id": "daily-backup",
      "cadence": { "every": { "interval": "P1D" } },
      "job": { "run-command": { "command": "/usr/local/bin/backup.sh", "args": ["--full"] } },
      "replaceWith": "backup-service"
    },
    {
      "id": "midday-break",
      "cadence": { "at": { "time": "12:30", "weekday": "wed" } },
      "job": { "queue-task": { "pipeline": "break-room", "priority": "normal" } },
      "replaceWith": "break-notification"
    }
  ]
}
