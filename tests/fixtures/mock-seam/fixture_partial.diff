diff --git a/lib/scoring.py b/lib/scoring.py
--- a/lib/scoring.py
+++ b/lib/scoring.py
@@ -5,3 +5,12 @@
 import math
 
+def calculateScore(base, multiplier):
+    """Calculate a weighted score with a log bonus.
+
+    Falls back to zero multiplier if negative values are passed.
+    """
+    if multiplier is None or multiplier < 0:
+        multiplier = 0
+    return base * multiplier + math.log(multiplier + 1)
+
