{
  "_doc": "Schedule file format. Top-level object with an 'entries' array. Each entry has: id (string, unique), cadence (object with exactly one of: at/every/rule), job (object with exactly one of: queue-task/run-command), node (string, defaults to 'wok'), replaceWith (optional string), migratedFrom (optional non-empty string).",
  "entries": [
    {
      "id": "example-weekday",
      "cadence": {
        "at": {
          "time": "07:30",
          "weekday": "mon"
        }
      },
      "job": {
        "queue-task": {
          "pipeline": "audit",
          "priority": "normal"
        }
      },
      "node": "wok",
      "replaceWith": "file-change-watcher"
    },
    {
      "id": "example-daily",
      "cadence": {
        "every": {
          "interval": "P1D"
        }
      },
      "job": {
        "run-command": {
          "command": "/usr/local/bin/backup.sh",
          "args": ["--full"],
          "env": { "BACKUP_DIR": "/mnt/backups" }
        }
      },
      "node": "wok",
      "replaceWith": "none yet"
    },
    {
      "id": "example-audit",
      "cadence": {
        "rule": {
          "name": "loop-audits"
        }
      },
      "job": {
        "queue-task": {
          "pipeline": "audit",
          "priority": "premium"
        }
      },
      "node": "wok",
      "migratedFrom": "loop-audit.timer"
    }
  ]
}
